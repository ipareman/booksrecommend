Table auth_user {
  id int [pk]
  username varchar(150)
}

Table django_content_type {
  id int [pk]
  app_label varchar(100)
  model varchar(100)
}

Table notifications_notification {
  id int [pk]
  user_id int [not null]
  kind varchar(32)
  actor_id int
  target_ct_id int
  target_id int
  text varchar(300)
  url varchar(500)
  extra json
  created_at datetime
  updated_at datetime
  read_at datetime
}

Table notifications_notificationsetting {
  id int [pk]
  event varchar(32) [unique]
  channel_telegram boolean
  channel_max boolean
  channel_vk boolean
  channel_email boolean
  updated_at datetime
}

Table tickets_ticket {
  id int [pk]
  user_id int [not null]
  kind varchar(16)
  status varchar(20)
  priority varchar(12)
  subject varchar(180)
  body text
  target_ct_id int
  target_id int
  target_label varchar(240)
  target_url varchar(500)
  admin_response text
  responded_by_id int
  responded_at datetime
  created_at datetime
  updated_at datetime
}

Ref: notifications_notification.user_id > auth_user.id
Ref: notifications_notification.actor_id > auth_user.id
Ref: notifications_notification.target_ct_id > django_content_type.id
Ref: tickets_ticket.user_id > auth_user.id
Ref: tickets_ticket.responded_by_id > auth_user.id
Ref: tickets_ticket.target_ct_id > django_content_type.id
