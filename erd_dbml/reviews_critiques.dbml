Table auth_user {
  id int [pk]
  username varchar(150)
}

Table books_book {
  id int [pk]
  title varchar(250)
  avg_rating float
  rating_count int
}

Table reviews_review {
  id int [pk]
  user_id int [not null]
  book_id int [not null]
  rating int [not null]
  text text
  status varchar(10)
  extracted_tag varchar(80)
  created_at datetime

  indexes {
    (user_id, book_id) [unique]
  }
}

Table reviews_reviewlike {
  id int [pk]
  user_id int [not null]
  review_id int [not null]
  created_at datetime

  indexes {
    (user_id, review_id) [unique]
  }
}

Table reviews_critique {
  id int [pk]
  user_id int [not null]
  book_id int [not null]
  title varchar(300)
  body text
  body_source text
  body_format varchar(10)
  final_rating int
  cover_image varchar(100)
  status varchar(10)
  extracted_tag varchar(80)
  created_at datetime
  updated_at datetime
}

Table reviews_critiquecriterion {
  id int [pk]
  critique_id int [not null]
  name varchar(100)
  rating int
}

Table reviews_critiquecomment {
  id int [pk]
  critique_id int [not null]
  user_id int [not null]
  parent_id int
  text text
  created_at datetime
  updated_at datetime
}

Table reviews_critiquecommentvote {
  id int [pk]
  user_id int [not null]
  comment_id int [not null]
  value int

  indexes {
    (user_id, comment_id) [unique]
  }
}

Table reviews_critiquelike {
  id int [pk]
  user_id int [not null]
  critique_id int [not null]
  created_at datetime

  indexes {
    (user_id, critique_id) [unique]
  }
}

Ref: reviews_review.user_id > auth_user.id
Ref: reviews_review.book_id > books_book.id
Ref: reviews_reviewlike.user_id > auth_user.id
Ref: reviews_reviewlike.review_id > reviews_review.id
Ref: reviews_critique.user_id > auth_user.id
Ref: reviews_critique.book_id > books_book.id
Ref: reviews_critiquecriterion.critique_id > reviews_critique.id
Ref: reviews_critiquecomment.critique_id > reviews_critique.id
Ref: reviews_critiquecomment.user_id > auth_user.id
Ref: reviews_critiquecomment.parent_id > reviews_critiquecomment.id
Ref: reviews_critiquecommentvote.user_id > auth_user.id
Ref: reviews_critiquecommentvote.comment_id > reviews_critiquecomment.id
Ref: reviews_critiquelike.user_id > auth_user.id
Ref: reviews_critiquelike.critique_id > reviews_critique.id
