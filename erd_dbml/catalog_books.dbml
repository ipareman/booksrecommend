Table auth_user {
  id int [pk]
  username varchar(150)
}

Table books_genre {
  id int [pk]
  name varchar(100) [unique, not null]
}

Table books_author {
  id int [pk]
  name varchar(250) [not null]
  bio text
  birth_year int
}

Table books_publisher {
  id int [pk]
  name varchar(250) [unique, not null]
  country varchar(120)
  city varchar(120)
  website varchar(200)
}

Table books_series {
  id int [pk]
  name varchar(250) [not null]
}

Table books_language {
  id int [pk]
  name varchar(100) [unique, not null]
}

Table books_bookedition {
  id int [pk]
  name varchar(250) [not null]
  created_at datetime
}

Table books_book {
  id int [pk]
  title varchar(250) [not null]
  isbn varchar(20) [unique]
  publication_year int
  pages int
  avg_rating float
  rating_count int
  publisher_id int
  series_id int
  series_order int
  edition_group_id int
  language_id int
  created_at datetime
}

Table books_book_authors {
  id int [pk]
  book_id int [not null]
  author_id int [not null]

  indexes {
    (book_id, author_id) [unique]
  }
}

Table books_book_genres {
  id int [pk]
  book_id int [not null]
  genre_id int [not null]

  indexes {
    (book_id, genre_id) [unique]
  }
}

Table books_booktext {
  id int [pk]
  book_id int [unique, not null]
  source_file varchar(100)
  source_format varchar(10)
  word_count int
  char_count int
  extract_status varchar(16)
  uploaded_by_id int
  uploaded_at datetime
}

Table books_bookchapter {
  id int [pk]
  book_text_id int [not null]
  order int [not null]
  title varchar(300)
  word_count int
  summary_status varchar(10)

  indexes {
    (book_text_id, order) [unique]
  }
}

Table books_quote {
  id int [pk]
  user_id int [not null]
  book_id int [not null]
  chapter_id int
  mood_tag_id int
  text text
  page_number int
  is_ai_generated boolean
  created_at datetime
}

Table books_booknote {
  id int [pk]
  user_id int [not null]
  book_id int [not null]
  chapter_id int
  excerpt text
  note text
  created_at datetime
}

Table books_moodtag {
  id int [pk]
  name varchar(50) [unique, not null]
  category varchar(20)
  icon varchar(10)
}

Table books_bookmood {
  id int [pk]
  book_id int [not null]
  mood_id int [not null]
  confidence float
  source varchar(20)
  vote_count int

  indexes {
    (book_id, mood_id) [unique]
  }
}

Ref: books_book.publisher_id > books_publisher.id
Ref: books_book.series_id > books_series.id
Ref: books_book.edition_group_id > books_bookedition.id
Ref: books_book.language_id > books_language.id
Ref: books_book_authors.book_id > books_book.id
Ref: books_book_authors.author_id > books_author.id
Ref: books_book_genres.book_id > books_book.id
Ref: books_book_genres.genre_id > books_genre.id
Ref: books_booktext.book_id > books_book.id
Ref: books_booktext.uploaded_by_id > auth_user.id
Ref: books_bookchapter.book_text_id > books_booktext.id
Ref: books_quote.user_id > auth_user.id
Ref: books_quote.book_id > books_book.id
Ref: books_quote.chapter_id > books_bookchapter.id
Ref: books_quote.mood_tag_id > books_moodtag.id
Ref: books_booknote.user_id > auth_user.id
Ref: books_booknote.book_id > books_book.id
Ref: books_booknote.chapter_id > books_bookchapter.id
Ref: books_bookmood.book_id > books_book.id
Ref: books_bookmood.mood_id > books_moodtag.id
