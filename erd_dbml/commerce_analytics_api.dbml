Table auth_user {
  id int [pk]
  username varchar(150)
}

Table books_book {
  id int [pk]
  title varchar(250)
  avg_price decimal(10,2)
  price_last_requested datetime
}

Table books_store {
  id int [pk]
  name varchar(250)
  base_url varchar(200)
  icon varchar(10)
  price_selector varchar(500)
  is_active boolean
}

Table books_bookstore {
  id int [pk]
  book_id int [not null]
  store_id int [not null]
  product_url varchar(500)
  current_price decimal(10,2)
  in_stock boolean
  last_checked datetime

  indexes {
    (book_id, store_id) [unique]
  }
}

Table books_bookprice {
  id int [pk]
  book_store_id int [not null]
  price decimal(10,2)
  created_at datetime
}

Table books_pricealert {
  id int [pk]
  user_id int [not null]
  book_id int [not null]
  threshold decimal(10,2)
  created_at datetime
  triggered_at datetime

  indexes {
    (user_id, book_id) [unique]
  }
}

Table analytics_storeclick {
  id int [pk]
  book_id int [not null]
  store_id int [not null]
  user_id int
  session_key varchar(40)
  referer varchar(500)
  created_at datetime
}

Table analytics_moderationlog {
  id int [pk]
  moderator_id int
  action varchar(32)
  target_type varchar(32)
  target_id int
  target_repr varchar(250)
  note varchar(500)
  created_at datetime
}

Table public_api_apikey {
  id int [pk]
  name varchar(120)
  owner_id int [not null]
  prefix varchar(12) [unique]
  key_hash varchar(64) [unique]
  is_active boolean
  created_at datetime
  last_used_at datetime
  revoked_at datetime
}

Table public_api_apirequestlog {
  id int [pk]
  api_key_id int
  path varchar(255)
  method varchar(8)
  status_code int
  remote_addr varchar(39)
  user_agent varchar(255)
  latency_ms int
  created_at datetime
}

Ref: books_bookstore.book_id > books_book.id
Ref: books_bookstore.store_id > books_store.id
Ref: books_bookprice.book_store_id > books_bookstore.id
Ref: books_pricealert.user_id > auth_user.id
Ref: books_pricealert.book_id > books_book.id
Ref: analytics_storeclick.book_id > books_book.id
Ref: analytics_storeclick.store_id > books_store.id
Ref: analytics_storeclick.user_id > auth_user.id
Ref: analytics_moderationlog.moderator_id > auth_user.id
Ref: public_api_apikey.owner_id > auth_user.id
Ref: public_api_apirequestlog.api_key_id > public_api_apikey.id
