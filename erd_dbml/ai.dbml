Table auth_user {
  id int [pk]
  username varchar(150)
}

Table books_book {
  id int [pk]
  title varchar(250)
}

Table ai_chat_bookchat {
  id int [pk]
  user_id int [not null]
  book_id int [not null]
  created_at datetime

  indexes {
    (user_id, book_id) [unique]
  }
}

Table ai_chat_bookchatmessage {
  id int [pk]
  chat_id int [not null]
  role varchar(10)
  content text
  created_at datetime
}

Table ai_chat_discoverychat {
  id int [pk]
  user_id int [not null]
  created_at datetime
  updated_at datetime
}

Table ai_chat_discoverychatmessage {
  id int [pk]
  chat_id int [not null]
  role varchar(10)
  content text
  books_meta json
  followup_options json
  disliked_book_ids json
  created_at datetime
}

Table ai_chat_discoverychatmessage_recommended_books {
  id int [pk]
  discoverychatmessage_id int [not null]
  book_id int [not null]

  indexes {
    (discoverychatmessage_id, book_id) [unique]
  }
}

Table ai_chat_bookcontent {
  id int [pk]
  book_id int [unique, not null]
  content_text text
  updated_at datetime
}

Table ai_admin_aiusagelog {
  id int [pk]
  created_at datetime
  user_id int
  feature varchar(32)
  tier varchar(10)
  model varchar(128)
  prompt_tokens int
  completion_tokens int
  total_tokens int
  latency_ms int
  status varchar(16)
  error_message text
}

Table ai_admin_aiconfig {
  id int [pk]
  provider varchar(16)
  custom_api_key varchar(256)
  custom_base_url varchar(256)
  model_main varchar(128)
  model_light varchar(128)
  model_fallback varchar(128)
  enable_discovery boolean
  enable_book_chat boolean
  enable_recommendations boolean
  enable_ai_search boolean
  enable_tag boolean
  enable_mood boolean
  enable_quotes boolean
  enable_sentiment boolean
  enable_chapter_summary boolean
  enable_book_themes boolean
  enable_book_search boolean
  enable_book_style boolean
  dry_run_mode boolean
  require_email_verification boolean
  updated_at datetime
}

Ref: ai_chat_bookchat.user_id > auth_user.id
Ref: ai_chat_bookchat.book_id > books_book.id
Ref: ai_chat_bookchatmessage.chat_id > ai_chat_bookchat.id
Ref: ai_chat_discoverychat.user_id > auth_user.id
Ref: ai_chat_discoverychatmessage.chat_id > ai_chat_discoverychat.id
Ref: ai_chat_discoverychatmessage_recommended_books.discoverychatmessage_id > ai_chat_discoverychatmessage.id
Ref: ai_chat_discoverychatmessage_recommended_books.book_id > books_book.id
Ref: ai_chat_bookcontent.book_id > books_book.id
Ref: ai_admin_aiusagelog.user_id > auth_user.id
